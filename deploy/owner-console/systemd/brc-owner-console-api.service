[Unit]
Description=BRC Owner Console API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brc
Group=www-data
SupplementaryGroups=brc
WorkingDirectory=/opt/brc/current
RuntimeDirectory=brc-owner-console
RuntimeDirectoryMode=0770
UMask=0007
Slice=brc-owner-console.slice
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
LoadCredential=owner_username:/etc/brc/owner-console-credentials/owner_username
LoadCredential=owner_password_hash:/etc/brc/owner-console-credentials/owner_password_hash
LoadCredential=owner_totp_seed:/etc/brc/owner-console-credentials/owner_totp_seed
LoadCredential=session_signing_key:/etc/brc/owner-console-credentials/session_signing_key
LoadCredential=database_dsn:/etc/brc/owner-console-credentials/database_dsn
LoadCredential=control_database_dsn:/etc/brc/owner-console-credentials/control_database_dsn
LoadCredential=account_id:/etc/brc/owner-console-credentials/account_id
ExecStart=/opt/brc/current/.venv-owner-console/bin/python scripts/owner_console/run_api.py --uds /run/brc-owner-console/api.sock
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
